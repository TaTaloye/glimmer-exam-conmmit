    "configurations": [
        {
            "name": "gcc.exe - ⽣成和调试活动⽂件",  // 该调试任务的名字，启动调试时会在待选列表中显⽰
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",            "args": [],
            "stopAtEntry": false,  //不在main()函数处停⽌
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,  //在ide的终端中启动调试程序，如果设置为true，则在外部终端中启动调试程序
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\EDIT\\msys2\\mingw64\\bin\\gdb.exe",  //指向调试器gdb.exe的路径
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc.exe build active file"  // 调试前的预执行任务，这里的值是tasks.json文件中对应的编译任务，也就是调试前需要先编译
        }
    ]
